{
  "name": "alexa",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "version": "1.0.0",
  "description": "an mcp-use server with React views for MCP Apps",
  "author": "mcp-use",
  "license": "MIT",
  "homepage": "https://github.com/mcp-use/mcp-use",
  "keywords": [
    "mcp",
    "mcp-server",
    "chatgpt plugins",
    "claude connector",
    "mcp-app",
    "mcp-use",
    "manufact"
  ],
  "scripts": {
    "build": "mcp-use build",
    "dev": "mcp-use dev",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "typecheck": "mcp-use typecheck",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "verify:protocol": "node scripts/verify-protocol.mjs",
    "verify:phase2-3": "node scripts/verify-phase2-3.mjs",
    "verify:deployed": "node scripts/verify-deployed.mjs",
    "verify:security": "npm run build && node scripts/verify-security.mjs",
    "oauth:token": "node scripts/get-oauth-token.mjs",
    "oauth:refresh": "node scripts/get-oauth-token.mjs --refresh"
  },
  "dependencies": {
    "@composio/core": "^0.27.0",
    "@mcp-use/client": "^2.4.3",
    "@modelcontextprotocol/client": "2.3.1",
    "mcp-use": "2.10.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2"
  }
}
