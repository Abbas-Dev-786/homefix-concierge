# Runtime
NODE_ENV=development
MCP_ENDPOINT_PATH=/mcp
MCP_URL=http://localhost:3000/mcp
LOG_LEVEL=info

# Composio Taskrabbit MCP (use a server-side project API key, usually ak_...)
COMPOSIO_API_KEY=
# Optional SDK base URL; use the API origin, not an /api/v3.1 path.
COMPOSIO_API_BASE_URL=https://backend.composio.dev
TASKRABBIT_TOOL_MAP_JSON=

# Supabase Auth and Postgres (required for later phases)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# mcp-use OAuth provider (optional explicit overrides)
MCP_USE_OAUTH_SUPABASE_PROJECT_ID=
MCP_USE_OAUTH_SUPABASE_JWT_SECRET=
# Optional local-only access token for scripts/verify-protocol.mjs; never commit it.
PHASE1_TEST_ACCESS_TOKEN=
# Dedicated test-user tokens for the authenticated Phase 2/3 verifier; never commit them.
PHASE23_TEST_ACCESS_TOKEN_A=
PHASE23_TEST_ACCESS_TOKEN_B=

# Security and outbound limits
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=256000
OUTBOUND_TIMEOUT_MS=12000
